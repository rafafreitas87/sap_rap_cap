<core:FragmentDefinition 
	xmlns:core="sap.ui.core"
	xmlns="sap.m"
	xmlns:l="sap.ui.layout" 	
	    xmlns:rte="sap.ui.richtexteditor"
	>
	<VBox id="vrte">
		  <rte:RichTextEditor 
            id="myRichTextEditor"
            width="100%"
            height="300px"
            editable="{ui>/editable}" 
            showGroupFont="true"
            showGroupInsert="true"
            showGroupLink="true"
            showGroupUndo="true"
            value="{TripDetails}" 
        />

       <!-- Comment Section -->
        <List id="feedList" 
              growing="true"
              items="{ path: 'to_feed', sorter: { path: 'Timestamp', descending: true } }">
            <FeedListItem id='feedListItem'
                sender="{Sender}"
                timestamp="{path: 'Timestamp', type: 'sap.ui.model.odata.type.DateTime'}"
                text="{Text}" />
        </List>

        <!-- Input for New Comments -->
        <FeedInput id="feedInput"
                   post="onPostComment"
                   placeholder="Add a comment..."
                   showIcon="true" />   
	</VBox>
</core:FragmentDefinition>
