<core:FragmentDefinition 
	xmlns:core="sap.ui.core"
	xmlns="sap.m"
	xmlns:l="sap.ui.layout" 	
	xmlns:rte="sap.ui.richtexteditor"
    xmlns:macros="sap.fe.macros"
	>
	<VBox id="vrte" 	core:require="{ handler: 'maingoal/test4/project4/ext/fragment/Rtefeed'}" >
		  <rte:RichTextEditor 
            id="myRichTextEditor"
            width="100%"
            height="300px"
            editable="{= !${IsActiveEntity} }"
            showGroupFont="true"
            showGroupInsert="true"
            showGroupLink="true"
            showGroupUndo="true"
            value="{TripDetails}" 
        />
         <!-- Input for New Comments -->
        <FeedInput id="feedInput"
                   post="handler.onPress"
                   enabled="{= !${IsActiveEntity} }"
                   placeholder="Add a comment..."   
                   showIcon="true" />   

       <!-- Comment Section -->
        <List id="feedList" 
              growing="true"
              items="{ path: '_feed', 
                           parameters: {
              $$ownRequest: true
          },
              sorter: { path: 'Timestamp', descending: true } }">
            <FeedListItem id='feedListItem'
                sender="{Sender}"
                timestamp="{Timestamp}"
                text="{Text}" />
        </List>

      
	</VBox>
</core:FragmentDefinition>